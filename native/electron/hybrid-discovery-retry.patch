diff --git a/device/bluetooth/bluez/bluetooth_adapter_bluez.cc b/device/bluetooth/bluez/bluetooth_adapter_bluez.cc
index 7103973846..c9bf206344 100644
--- a/device/bluetooth/bluez/bluetooth_adapter_bluez.cc
+++ b/device/bluetooth/bluez/bluetooth_adapter_bluez.cc
@@ -1960,6 +1960,12 @@ void BluetoothAdapterBlueZ::OnStartDiscoveryError(
     DiscoverySessionResultCallback callback,
     const std::string& error_name,
     const std::string& error_message) {
+  if (error_name == "org.bluez.Error.InProgress" && IsDiscovering()) {
+    BLUETOOTH_LOG(EVENT) << object_path_.value()
+                         << ": Sharing an already active discovery session.";
+    OnStartDiscovery(std::move(callback));
+    return;
+  }
   BLUETOOTH_LOG(ERROR) << object_path_.value()
                        << ": Failed to start discovery: " << error_name << ": "
                        << error_message;
diff --git a/device/fido/cable/v2_discovery.cc b/device/fido/cable/v2_discovery.cc
index 839102f7a2..6e64e8ff42 100644
--- a/device/fido/cable/v2_discovery.cc
+++ b/device/fido/cable/v2_discovery.cc
@@ -450,11 +450,20 @@ void Discovery::StartCableDiscovery() {
 void Discovery::OnStartDiscoverySession(
     std::unique_ptr<BluetoothDiscoverySession> session) {
   FIDO_LOG(DEBUG) << "Discovery session started.";
+  scan_start_retries_ = 0;
   SetDiscoverySession(std::move(session));
 }
 
 void Discovery::OnStartDiscoverySessionError() {
   FIDO_LOG(ERROR) << "Failed to start caBLE discovery";
+  if (scan_start_retries_ >= 3 || !adapter() || !adapter()->IsPowered())
+    return;
+  ++scan_start_retries_;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&Discovery::StartCableDiscovery,
+                     weak_factory_.GetWeakPtr()),
+      base::Milliseconds(750 * scan_start_retries_));
 }
 
 }  // namespace device::cablev2
