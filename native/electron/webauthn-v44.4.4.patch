+void ElectronAuthenticatorRequestClientDelegate::CollectPIN(
+    CollectPINOptions options,
+    base::OnceCallback<void(std::u16string)> provide_pin_cb) {
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  content::WebContents* contents =
+      rfh ? content::WebContents::FromRenderFrameHost(rfh) : nullptr;
+  gin::WeakCell<api::Session>* session =
+      contents ? api::Session::FromBrowserContext(contents->GetBrowserContext())
+               : nullptr;
+  provide_pin_callback_ = std::move(provide_pin_cb);
+  if (!session || !session->Get()) {
+    provide_pin_callback_.Reset();
+    if (cancel_callback_)
+      std::move(cancel_callback_).Run();
+    return;
+  }
+
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> details =
+      gin::DataObjectBuilder(isolate)
+          .Set("requestId", request_id_)
+          .Set("relyingPartyId", relying_party_id_)
+          .Set("frame", rfh)
+          .Set("reason", std::string(PINReasonName(options.reason)))
+          .Set("error", std::string(PINErrorName(options.error)))
+          .Set("minPinLength", options.min_pin_length)
+          .Set("attempts", options.attempts)
+          .Build();
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper)) {
+    provide_pin_callback_.Reset();
+    if (cancel_callback_)
+      std::move(cancel_callback_).Run();
+    return;
+  }
+  v8::Local<v8::Object> event = gin_helper::internal::Event::New(isolate)
+                                    ->GetWrapper(isolate)
+                                    .ToLocalChecked();
+  base::WeakPtr<ElectronAuthenticatorRequestClientDelegate> weak_this =
+      weak_factory_.GetWeakPtr();
+  v8::Local<v8::Value> result = gin_helper::EmitEvent(
+      isolate, wrapper, "webauthn-pin-request", event, details,
+      base::BindRepeating(
+          &ElectronAuthenticatorRequestClientDelegate::OnPINProvided,
+          weak_factory_.GetWeakPtr()));
+  if (!weak_this)
+    return;
+  bool had_listener = false;
+  if (!gin::ConvertFromV8(isolate, result, &had_listener) || !had_listener) {
+    provide_pin_callback_.Reset();
+    if (cancel_callback_)
+      std::move(cancel_callback_).Run();
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnPINProvided(
+    gin::Arguments* args) {
+  if (!provide_pin_callback_)
+    return;
+  std::u16string pin;
+  if (!args->GetNext(&pin) || pin.empty()) {
+    provide_pin_callback_.Reset();
+    if (cancel_callback_)
+      std::move(cancel_callback_).Run();
+    return;
+  }
+  std::move(provide_pin_callback_).Run(std::move(pin));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::ConfigureDiscoveries(
+    const url::Origin& origin,
+    const std::string& rp_id,
+    RequestSource request_source,
+    device::FidoRequestType request_type,
+    std::optional<device::ResidentKeyRequirement> resident_key_requirement,
+    device::UserVerificationRequirement user_verification_requirement,
+    bool cmtg_key_requested,
+    std::optional<std::string_view> user_name,
+    bool is_enclave_authenticator_available,
+    device::FidoDiscoveryFactory* factory) {
+  if (!factory || request_source != RequestSource::kWebAuthentication)
+    return;
+  std::array<uint8_t, device::cablev2::kQRKeySize> qr_key;
+  crypto::RandBytes(qr_key);
+  hybrid_qr_ = device::cablev2::qr::Encode(qr_key, request_type);
+  factory->set_cable_data(request_type, qr_key);
+  factory->set_cable_event_callback(base::BindRepeating(
+      &ElectronAuthenticatorRequestClientDelegate::OnCableEvent,
+      weak_factory_.GetWeakPtr()));
+  factory->set_network_context_factory(base::BindRepeating(
+      [](content::GlobalRenderFrameHostId frame_id)
+          -> network::mojom::NetworkContext* {
+        auto* frame = content::RenderFrameHost::FromID(frame_id);
+        return frame ? frame->GetBrowserContext()
+                           ->GetDefaultStoragePartition()
+                           ->GetNetworkContext()
+                     : nullptr;
+      },
+      render_frame_host_id_));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::
+    OnTransportAvailabilityEnumerated(
+        device::FidoRequestHandlerBase::TransportAvailabilityInfo data) {
+  const bool hybrid_available =
+      !hybrid_qr_.empty() && data.available_transports.contains(
+                                 device::FidoTransportProtocol::kHybrid);
+  const bool security_key_available =
+      data.available_transports.contains(
+          device::FidoTransportProtocol::kUsbHumanInterfaceDevice) ||
+      data.available_transports.contains(
+          device::FidoTransportProtocol::kNearFieldCommunication) ||
+      data.available_transports.contains(
+          device::FidoTransportProtocol::kBluetoothLowEnergy);
+  const bool platform_available = data.available_transports.contains(
+      device::FidoTransportProtocol::kInternal);
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  content::WebContents* contents =
+      rfh ? content::WebContents::FromRenderFrameHost(rfh) : nullptr;
+  gin::WeakCell<api::Session>* session =
+      contents ? api::Session::FromBrowserContext(contents->GetBrowserContext())
+               : nullptr;
+  if (!session || !session->Get())
+    return;
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> details =
+      gin::DataObjectBuilder(isolate)
+          .Set("requestId", request_id_)
+          .Set("relyingPartyId", relying_party_id_)
+          .Set("frame", rfh)
+          .Set("qr", hybrid_qr_)
+          .Set("bluetoothStatus",
+               std::string(BluetoothStatusName(data.ble_status)))
+          .Set("canPowerOnBluetooth", data.can_power_on_ble_adapter)
+          .Build();
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper))
+    return;
+  v8::Local<v8::Object> event = gin_helper::internal::Event::New(isolate)
+                                    ->GetWrapper(isolate)
+                                    .ToLocalChecked();
+  v8::Local<v8::Object> transports =
+      gin::DataObjectBuilder(isolate)
+          .Set("requestId", request_id_)
+          .Set("relyingPartyId", relying_party_id_)
+          .Set("frame", rfh)
+          .Set("securityKeyAvailable", security_key_available)
+          .Set("phoneAvailable", hybrid_available)
+          .Set("platformAvailable", platform_available)
+          .Build();
+  base::WeakPtr<ElectronAuthenticatorRequestClientDelegate> weak_this =
+      weak_factory_.GetWeakPtr();
+  gin_helper::EmitEvent(
+      isolate, wrapper, "webauthn-transport-state", event, transports,
+      base::BindRepeating(
+          &ElectronAuthenticatorRequestClientDelegate::OnHybridAction,
+          weak_factory_.GetWeakPtr()));
+  if (!weak_this || !hybrid_available)
+    return;
+  event = gin_helper::internal::Event::New(isolate)
+              ->GetWrapper(isolate)
+              .ToLocalChecked();
+  gin_helper::EmitEvent(
+      isolate, wrapper, "webauthn-hybrid-qr", event, details,
+      base::BindRepeating(
+          &ElectronAuthenticatorRequestClientDelegate::OnHybridAction,
+          weak_factory_.GetWeakPtr()));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnHybridAction(
+    gin::Arguments* args) {
+  std::string action;
+  if (!args->GetNext(&action))
+    return;
+  if (action == "cancel" && cancel_callback_) {
+    provide_pin_callback_.Reset();
+    std::move(cancel_callback_).Run();
+  } else if (hybrid_qr_.empty()) {
+    return;
+  } else if (action == "power-on-bluetooth" && bluetooth_power_on_callback_) {
+    bluetooth_power_on_callback_.Run();
+  } else if (action == "request-bluetooth-permission" &&
+             request_bluetooth_permission_callback_) {
+    request_bluetooth_permission_callback_.Run(
+        base::BindOnce(&ElectronAuthenticatorRequestClientDelegate::
+                           OnBluetoothPermissionResult,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnBluetoothPermissionResult(
+    device::FidoRequestHandlerBase::BleStatus status) {
+  BluetoothAdapterStatusChanged(status);
+}
