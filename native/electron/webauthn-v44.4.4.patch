+void ElectronAuthenticatorRequestClientDelegate::OnCableEvent(
+    device::cablev2::Event event) {
+  const char* state = nullptr;
+  switch (event) {
+    case device::cablev2::Event::kPhoneConnected:
+      state = "phone-connected";
+      break;
+    case device::cablev2::Event::kBLEAdvertReceived:
+      state = "bluetooth-seen";
+      break;
+    case device::cablev2::Event::kReady:
+      state = "ready";
+      break;
+  }
+  if (!state)
+    return;
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  content::WebContents* contents =
+      rfh ? content::WebContents::FromRenderFrameHost(rfh) : nullptr;
+  gin::WeakCell<api::Session>* session =
+      contents ? api::Session::FromBrowserContext(contents->GetBrowserContext())
+               : nullptr;
+  if (!session || !session->Get())
+    return;
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> details = gin::DataObjectBuilder(isolate)
+                                      .Set("requestId", request_id_)
+                                      .Set("status", std::string(state))
+                                      .Build();
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper))
+    return;
+  v8::Local<v8::Object> notification = gin_helper::internal::Event::New(isolate)
+                                           ->GetWrapper(isolate)
+                                           .ToLocalChecked();
+  gin_helper::EmitEvent(isolate, wrapper, "webauthn-hybrid-progress",
+                        notification, details);
+}
